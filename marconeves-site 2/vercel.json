{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/moradia-benavente-historica",
      "destination": "/moradia-benavente-historica.html"
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|LinkedInBot|WhatsApp|Twitterbot|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Embedly|vkShare|Applebot).*"
        }
      ],
      "destination": "/og/blog/:slug.html"
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|LinkedInBot|WhatsApp|Twitterbot|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Embedly|vkShare|Applebot).*"
        }
      ],
      "destination": "/og/blog.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
