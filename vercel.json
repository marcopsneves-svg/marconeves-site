{
  "installCommand": "cd \"marconeves-site 2\" && npm install",
  "buildCommand": "cd \"marconeves-site 2\" && npm run build",
  "outputDirectory": "marconeves-site 2/build",
  "rewrites": [
    {
      "source": "/moradia-benavente-historica",
      "destination": "/moradia-benavente-historica.html"
    },
    {
      "source": "^/blog/([a-z0-9-]+)/?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|LinkedInBot|WhatsApp|Twitterbot|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Embedly|vkShare|Applebot).*"
        }
      ],
      "destination": "/og/blog/$1.html"
    },
    {
      "source": "^/blog/?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|LinkedInBot|WhatsApp|Twitterbot|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Embedly|vkShare|Applebot).*"
        }
      ],
      "destination": "/og/blog.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
